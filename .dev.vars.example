# Copy to `.dev.vars` for local development (gitignored).
# These are read by the Cloudflare platform proxy during `npm run dev`
# and by `wrangler pages dev` during `npm run preview`.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact submissions are emailed.
CONTACT_TO=example@gmail.com

# The "from" address. Until you verify a domain in Resend you can use
# the shared onboarding sender below (deliverability is limited).
# Once jchen.me is verified, switch to e.g. "Jimmy Chen <hello@jchen.me>".
CONTACT_FROM=Contact Form <onboarding@resend.dev>

# Optional: rolling-24h cap on contact emails for this site (default 10).
# Leave unset when running the tests -- tests/contact-cap.spec.ts assumes 10.
# CONTACT_DAILY_MAX=10

# Optional: Turnstile secret. Enforced only when PUBLIC_TURNSTILE_SITE_KEY is
# also set (a BUILD variable, not read from this file). Cloudflare's public
# always-pass test secret, for local testing:
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
