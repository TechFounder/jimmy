---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jimmy Chen — Engineering Manager, QA",
  description = "Jimmy Chen is an Engineering Manager for QA at Teladoc Health, with a decade of hands-on full-stack engineering behind him. Portfolio, background, and a way to get in touch.",
} = Astro.props;

// Self-referencing canonical URL, resolved against the `site` value in
// astro.config.mjs (https://jchen.me). Tells Google which address is the
// definitive one so duplicate variants (trailing slash, www, http) don't
// compete with the real page.
const canonical = new URL(Astro.url.pathname, Astro.site);

// Social crawlers (X, LinkedIn, Slack, iMessage) do not resolve relative
// paths — og:image must be an absolute URL. This lives in public/, not
// src/assets/, because crawlers need a stable un-hashed URL. It is a
// purpose-built 1200x630 card: a square headshot would be centre-cropped
// to a letterbox strip by summary_large_image.
const ogImage = new URL("/images/og-card.jpg", Astro.site);

// Person schema. Deliberately omits `worksFor`: Jimmy is between roles, so
// asserting a current employer here would be inaccurate structured data.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jimmy Chen",
  url: new URL("/", Astro.site).href,
  image: new URL("/images/headshot.jpg", Astro.site).href,
  jobTitle: "Engineering Manager, QA",
  description,
  sameAs: [
    "https://www.linkedin.com/in/jimmychen2/",
    "https://github.com/TechFounder",
    "https://twitter.com/JimmyCsaid",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jimmy Chen — Engineering Manager, QA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#07080f" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body>
    <!-- Aurora background -->
    <div class="aurora" data-aurora aria-hidden="true">
      <span class="b1"></span>
      <span class="b2"></span>
      <span class="b3"></span>
    </div>
    <div class="aurora-veil" aria-hidden="true"></div>

    <!-- Custom cursor (shown only on fine pointers via JS) -->
    <div class="cursor-ring" data-cursor-ring aria-hidden="true"></div>
    <div class="cursor-dot" data-cursor-dot aria-hidden="true"></div>

    <slot />

    <!-- Scroll-reveal: progressive enhancement, respects reduced motion -->
    <script>
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const targets = document.querySelectorAll("[data-reveal]");

      if (reduce || !("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
